// RFS HCM — database schema
// Database: MySQL / MariaDB (Hostinger). List-like values are stored as JSON.
// Conventions:
//   * Instants are stored as UTC. Business calendar dates (joining date, DOB, effective dates) are `@db.Date`.
//   * Money is Decimal(14,2) in PKR. Never floats.
//   * Sensitive fields ending in `Enc` hold AES-256-GCM ciphertext produced by src/server/crypto.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ Company & organisation â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model Company {
  id          String   @id @default(cuid())
  legalName   String
  shortName   String
  address     String?  @db.VarChar(500)
  phone       String?
  email       String?
  website     String?  @db.VarChar(300)
  ntn         String?
  logoPath    String?
  timezone    String   @default("Asia/Karachi")
  currency    String   @default("PKR")
  /// Weekly off days as a JSON array, 0 = Sunday … 6 = Saturday
  weekendDays Json
  /// Attendance is shown, counted and paid from this date; earlier days were managed in another system
  attendanceStartDate DateTime? @db.Date
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Public holiday: a company-wide off day, treated exactly like a weekend day (no absence, no deduction)
model Holiday {
  id        String   @id @default(cuid())
  date      DateTime @unique @db.Date
  name      String   @db.VarChar(120)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Department {
  id          String     @id @default(cuid())
  name        String     @unique
  code        String?    @unique
  description String?    @db.VarChar(500)
  isActive    Boolean    @default(true)
  employees   Employee[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Designation {
  id        String     @id @default(cuid())
  title     String     @unique
  isActive  Boolean    @default(true)
  employees Employee[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

/// Work shift. Times are minutes after midnight in the company timezone; endMinute < startMinute means it crosses midnight.
model Shift {
  id           String     @id @default(cuid())
  name         String     @unique
  startMinute  Int
  endMinute    Int
  graceMinutes Int        @default(15)
  isDefault    Boolean    @default(false)
  isActive     Boolean    @default(true)
  employees    Employee[]
  dayOverrides ShiftDayOverride[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

/// Different timing on a specific weekday (e.g. Friday 3:00 PM – 12:00 AM). Grace falls back to the shift's.
model ShiftDayOverride {
  id           String @id @default(cuid())
  shiftId      String
  shift        Shift  @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  /// 0 = Sunday … 6 = Saturday
  weekday      Int
  startMinute  Int
  endMinute    Int
  graceMinutes Int?

  @@unique([shiftId, weekday])
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ Employees â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

enum EmploymentType {
  PERMANENT
  PROBATION
  CONTRACT
  INTERN
  PART_TIME
}

enum EmploymentStatus {
  ACTIVE
  INACTIVE
  RESIGNED
  TERMINATED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

model Employee {
  id             String           @id @default(cuid())
  employeeCode   String           @unique
  fullName       String
  fatherName     String?
  maritalStatus  String?
  grade          String?
  photoPath      String?
  email          String?          @unique
  phone          String?
  gender         Gender?
  dateOfBirth    DateTime?        @db.Date
  cnicEnc        String?
  address        String?          @db.VarChar(500)
  joiningDate    DateTime         @db.Date
  exitDate       DateTime?        @db.Date
  employmentType EmploymentType   @default(PERMANENT)
  status         EmploymentStatus @default(ACTIVE)
  /// User ID enrolled on the biometric device (matches device punches to this employee)
  deviceUserId   String?          @unique

  departmentId  String?
  department    Department?  @relation(fields: [departmentId], references: [id])
  designationId String?
  designation   Designation? @relation(fields: [designationId], references: [id])
  shiftId       String?
  shift         Shift?       @relation(fields: [shiftId], references: [id])
  managerId     String?
  manager       Employee?    @relation("ReportingLine", fields: [managerId], references: [id])
  reports       Employee[]   @relation("ReportingLine")

  salaryStructures  SalaryStructure[]
  bankAccount       BankAccount?
  emergencyContacts EmergencyContact[]
  user              User?
  rawPunches        RawPunch[]
  attendanceDays    AttendanceDay[]
  attendanceAdjustments AttendanceAdjustment[]
  payrollItems      PayrollItem[]
  leaveRequests     LeaveRequest[]
  loans             Loan[]
  documents         EmployeeDocument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([departmentId])
  @@index([managerId])
  @@index([status])
}

/// Effective-dated salary. The structure in force on a date is the latest one with effectiveFrom <= that date.
model SalaryStructure {
  id            String            @id @default(cuid())
  employeeId    String
  employee      Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  effectiveFrom DateTime          @db.Date
  basicSalary   Decimal           @db.Decimal(14, 2)
  note          String?           @db.VarChar(500)
  allowances    SalaryAllowance[]
  createdById   String?
  createdAt     DateTime          @default(now())

  @@unique([employeeId, effectiveFrom])
}

model SalaryAllowance {
  id                String          @id @default(cuid())
  salaryStructureId String
  salaryStructure   SalaryStructure @relation(fields: [salaryStructureId], references: [id], onDelete: Cascade)
  name              String
  amount            Decimal         @db.Decimal(14, 2)
}

model BankAccount {
  id               String   @id @default(cuid())
  employeeId       String   @unique
  employee         Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  bankName         String
  branch           String?
  accountTitle     String
  accountNumberEnc String
  ibanEnc          String?
  updatedAt        DateTime @updatedAt
}

model EmergencyContact {
  id           String   @id @default(cuid())
  employeeId   String
  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  name         String
  relationship String
  phone        String
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ Identity & access â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model Role {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?  @db.VarChar(500)
  /// JSON array of grants such as "employee.read:all" — see src/server/auth/permissions.ts
  permissions Json
  isSystem    Boolean  @default(false)
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model User {
  id                 String    @id @default(cuid())
  /// Login email (optional — users can also sign in with their Employee ID)
  email              String?   @unique
  passwordHash       String
  displayName        String
  roleId             String
  role               Role      @relation(fields: [roleId], references: [id])
  employeeId         String?   @unique
  employee           Employee? @relation(fields: [employeeId], references: [id])
  isActive           Boolean   @default(true)
  mustChangePassword Boolean   @default(true)
  failedLoginCount   Int       @default(0)
  lockedUntil        DateTime?
  lastLoginAt        DateTime?
  passwordChangedAt  DateTime?
  sessions           Session[]
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model Session {
  id         String   @id @default(cuid())
  /// SHA-256 of the session token; the raw token only ever lives in the user's cookie
  tokenHash  String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  lastSeenAt DateTime @default(now())
  ip         String?
  userAgent  String?  @db.VarChar(500)
  createdAt  DateTime @default(now())

  @@index([userId])
}

/// Append-only record of security-relevant and data-changing actions.
model AuditLog {
  id          BigInt   @id @default(autoincrement())
  actorUserId String?
  actorName   String?
  action      String
  entityType  String
  entityId    String?
  before      Json?
  after       Json?
  ip          String?
  userAgent   String?  @db.VarChar(500)
  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorUserId])
  @@index([createdAt])
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ Attendance â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

enum PunchSource {
  IMPORT
  AGENT
  MANUAL
}

/// Raw biometric punch exactly as received. Never updated or deleted; duplicates are rejected by the unique key.
model RawPunch {
  id            String       @id @default(cuid())
  source        PunchSource
  /// Device serial number, or "" when the source file does not include it
  deviceSerial  String       @default("")
  deviceUserId  String
  /// Instant of the punch (device local time converted from Asia/Karachi to UTC)
  punchedAt     DateTime
  deviceLocal   String
  punchState    String?
  verifyMode    String?
  employeeId    String?
  employee      Employee?    @relation(fields: [employeeId], references: [id])
  importId      String?
  import        PunchImport? @relation(fields: [importId], references: [id])
  createdAt     DateTime     @default(now())

  @@unique([deviceSerial, deviceUserId, punchedAt])
  @@index([employeeId, punchedAt])
  @@index([deviceUserId])
  @@index([punchedAt])
}

model PunchImport {
  id           String     @id @default(cuid())
  fileName     String     @db.VarChar(300)
  format       String
  uploadedById String
  rowsRead     Int
  inserted     Int
  duplicates   Int
  unmatched    Int
  invalid      Int
  firstPunchAt DateTime?
  lastPunchAt  DateTime?
  punches      RawPunch[]
  createdAt    DateTime   @default(now())
}

enum AttendanceStatus {
  PRESENT
  LATE
  EARLY
  HALF_DAY
  SHORT_DAY
  ABSENT
  LEAVE
  MISSING
}

/// One processed attendance result per employee per work date, derived from raw punches.
/// Recalculated whenever punches or rules change, until the payroll period containing it is locked (Phase 3).
model AttendanceDay {
  id                String           @id @default(cuid())
  employeeId        String
  employee          Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  workDate          DateTime         @db.Date
  status            AttendanceStatus
  firstIn           DateTime?
  lastOut           DateTime?
  punchCount        Int              @default(0)
  workedMinutes     Int?
  lateMinutes       Int              @default(0)
  earlyLeaveMinutes Int              @default(0)
  isOffDay          Boolean          @default(false)
  /// true when a manual adjustment changed check-in/check-out for this day
  isAdjusted        Boolean          @default(false)
  shiftId           String?
  computedAt        DateTime         @default(now())

  @@unique([employeeId, workDate])
  @@index([workDate])
}

// â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ Biometric devices & sync agents â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

/// On-premise program that receives punches from devices on the office LAN and forwards them over HTTPS.
model SyncAgent {
  id          String             @id @default(cuid())
  name        String
  /// HMAC secret, encrypted with FIELD_ENCRYPTION_KEY (shown to the admin once at creation)
  secretEnc   String             @db.Text
  isActive    Boolean            @default(true)
  version     String?
  lastSeenAt  DateTime?
  lastIp      String?
  outboxCount Int?
  devices     AttendanceDevice[]
  commands    AgentCommand[]
  createdAt   DateTime           @default(now())
}

model AttendanceDevice {
  id           String     @id @default(cuid())
  serialNumber String     @unique
  name         String?
  model        String?
  firmware     String?
  pushVersion  String?
  agentId      String?
  agent        SyncAgent? @relation(fields: [agentId], references: [id])
  isActive     Boolean    @default(true)
  lastSeenAt   DateTime?
  lastPunchAt  DateTime?
  createdAt    DateTime   @default(now())
}

enum AgentCommandStatus {
  PENDING
  SENT
  DONE
  FAILED
}

/// Work for an agent, e.g. ask a device to re-send attendance for a date range ("Sync now").
model AgentCommand {
  id           String             @id @default(cuid())
  agentId      String
  agent        SyncAgent          @relation(fields: [agentId], references: [id], onDelete: Cascade)
  deviceSerial String
  type         String
  payload      Json
  status       AgentCommandStatus @default(PENDING)
  result       String?            @db.Text
  createdById  String?
  createdAt    DateTime           @default(now())
  sentAt       DateTime?
  completedAt  DateTime?

  @@index([agentId, status])
}

/// Manual correction of a work day's check-in and/or check-out by an authorised user. Raw punches are never
/// changed; the attendance engine uses these times in place of the machine's.
model AttendanceAdjustment {
  id          String    @id @default(cuid())
  employeeId  String
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  workDate    DateTime  @db.Date
  checkIn     DateTime?
  checkOut    DateTime?
  /// WORK_FROM_HOME, LOAD_SHEDDING or OTHER
  category    String    @default("OTHER")
  /// Company-sanctioned: the day counts as Present with no late/early (e.g. load-shedding early off)
  excused     Boolean   @default(false)
  reason      String    @db.VarChar(500)
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([employeeId, workDate])
}

// ───────────────────────────── Payroll ─────────────────────────────

enum PayrollStatus {
  DRAFT
  SUBMITTED
  APPROVED
  PAID
}

/// One payroll per calendar month. Items are frozen snapshots: once APPROVED nothing in the run changes,
/// whatever happens to attendance or salaries afterwards.
model PayrollRun {
  id            String        @id @default(cuid())
  year          Int
  month         Int
  status        PayrollStatus @default(DRAFT)
  preparedById  String
  calculatedAt  DateTime      @default(now())
  submittedById String?
  submittedAt   DateTime?
  approvedById  String?
  approvedAt    DateTime?
  rejectedNote  String?       @db.Text
  paidAt        DateTime?
  items         PayrollItem[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([year, month])
}

model PayrollItem {
  id                String              @id @default(cuid())
  runId             String
  run               PayrollRun          @relation(fields: [runId], references: [id], onDelete: Cascade)
  employeeId        String?
  employee          Employee?           @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  // Snapshot of the employee at calculation time
  employeeCode      String
  fullName          String
  department        String?
  designation       String?
  // Salary & attendance basis
  basicSalary       Decimal             @db.Decimal(14, 2)
  allowances        Json
  grossSalary       Decimal             @db.Decimal(14, 2)
  daysInMonth       Int
  perDayRate        Decimal             @db.Decimal(14, 2)
  employedDays      Int
  presentDays       Int
  absentDays        Int
  lateCount         Int
  missingPunchCount Int
  lateDeductionDays Int
  notSyncedDays     Int
  // Result
  earnings          Decimal             @db.Decimal(14, 2)
  deductions        Decimal             @db.Decimal(14, 2)
  netPay            Decimal             @db.Decimal(14, 2)
  /// Explanation lines: { kind: "EARNING"|"DEDUCTION", code, label, amount }
  lines             Json
  /// JSON array of strings
  warnings          Json
  adjustments       PayrollAdjustment[]
  loanRepayments    LoanRepayment[]

  @@unique([runId, employeeId])
  @@index([runId])
}

enum PayrollAdjustmentKind {
  EARNING
  DEDUCTION
}

/// Manual line added by HR before submission: bonus, advance recovery, other authorised deduction, arrears…
model PayrollAdjustment {
  id          String                @id @default(cuid())
  itemId      String
  item        PayrollItem           @relation(fields: [itemId], references: [id], onDelete: Cascade)
  kind        PayrollAdjustmentKind
  label       String
  amount      Decimal               @db.Decimal(14, 2)
  createdById String
  createdAt   DateTime              @default(now())
}

// ───────────────────────────── Leave ─────────────────────────────

/// Company-defined leave type (e.g. Annual, Sick, Casual, Unpaid). Entitlement is per calendar year.
model LeaveType {
  id             String         @id @default(cuid())
  name           String         @unique
  code           String?        @unique
  isPaid         Boolean        @default(true)
  /// Working days per calendar year; null = no limit (typical for unpaid leave)
  daysPerYear    Int?
  /// Only permanent employees can take this leave (client rule: no leave during probation)
  permanentOnly  Boolean        @default(false)
  isActive       Boolean        @default(true)
  requests       LeaveRequest[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model LeaveRequest {
  id           String      @id @default(cuid())
  employeeId   String
  employee     Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveTypeId  String
  leaveType    LeaveType   @relation(fields: [leaveTypeId], references: [id])
  startDate    DateTime    @db.Date
  endDate      DateTime    @db.Date
  /// Working days in the range (weekends excluded), fixed when the request is made
  days         Int
  reason       String      @db.VarChar(1000)
  status       LeaveStatus @default(PENDING)
  requestedById String
  decidedById  String?
  decidedAt    DateTime?
  decisionNote String?     @db.VarChar(1000)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([employeeId, startDate])
  @@index([status])
}

// ───────────────────────────── Loans ─────────────────────────────

enum LoanStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
  CANCELLED
}

enum LoanRepaymentSource {
  PAYROLL
  CASH
}

/// Interest-free salary advance, repaid by fixed monthly installments deducted in payroll (see src/core/loans/schedule.ts).
model Loan {
  id                String          @id @default(cuid())
  employeeId        String
  employee          Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  /// Whole rupees
  amount            Decimal         @db.Decimal(14, 2)
  installments      Int
  /// Regular monthly installment (amount ÷ installments, rounded; HR may change it); the last one takes the remainder
  installmentAmount Decimal         @db.Decimal(14, 2)
  /// First payroll month the installment is deducted in
  startYear         Int
  startMonth        Int
  reason            String          @db.Text
  status            LoanStatus      @default(PENDING)
  requestedById     String?
  decidedById       String?
  decidedAt         DateTime?
  decisionNote      String?         @db.VarChar(1000)
  cancelledById     String?
  cancelledAt       DateTime?
  cancelNote        String?         @db.VarChar(1000)
  repayments        LoanRepayment[]
  monthOverrides    LoanMonthOverride[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([employeeId, status])
  @@index([status])
}

/// Money received against a loan. PAYROLL rows are written when the payroll run is approved, never for drafts.
model LoanRepayment {
  id            String              @id @default(cuid())
  loanId        String
  loan          Loan                @relation(fields: [loanId], references: [id], onDelete: Cascade)
  amount        Decimal             @db.Decimal(14, 2)
  source        LoanRepaymentSource
  payrollItemId String?
  payrollItem   PayrollItem?        @relation(fields: [payrollItemId], references: [id], onDelete: SetNull)
  /// Payroll month (PAYROLL) or month of the payment date (CASH)
  year          Int
  month         Int
  paidOn        DateTime            @db.Date
  note          String?             @db.VarChar(500)
  createdById   String?
  createdAt     DateTime            @default(now())

  @@unique([loanId, payrollItemId])
}

/// HR's change to one month of a loan: amount null or 0 skips the month (the schedule moves on by a month); more
/// than 0 is deducted instead of the regular installment (never more than the balance).
model LoanMonthOverride {
  id          String   @id @default(cuid())
  loanId      String
  loan        Loan     @relation(fields: [loanId], references: [id], onDelete: Cascade)
  year        Int
  month       Int
  /// Whole rupees; null or 0 = skip
  amount      Decimal? @db.Decimal(14, 2)
  createdById String?
  createdAt   DateTime @default(now())

  @@unique([loanId, year, month])
}

// ───────────────────────────── Documents ─────────────────────────────

enum DocumentCategory {
  CNIC
  CV
  OFFER_LETTER
  CONTRACT
  EDUCATION
  EXPERIENCE
  MEDICAL
  OTHER
}

/// A file kept on an employee's record (CNIC copy, contract, certificates). The bytes live on disk under STORAGE_DIR.
model EmployeeDocument {
  id           String           @id @default(cuid())
  employeeId   String
  employee     Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  category     DocumentCategory
  title        String           @db.VarChar(200)
  /// Original file name, sanitised (src/core/documents/files.ts)
  fileName     String           @db.VarChar(255)
  /// Detected from the file's bytes, not taken from the browser
  mimeType     String           @db.VarChar(100)
  sizeBytes    Int
  /// Path relative to STORAGE_DIR, e.g. documents/<employeeId>/<docId>.pdf
  storageKey   String           @db.VarChar(300)
  /// e.g. CNIC expiry
  expiresOn    DateTime?        @db.Date
  uploadedById String?
  createdAt    DateTime         @default(now())

  @@index([employeeId])
}
