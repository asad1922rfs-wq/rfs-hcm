# Copy to docker/.env.prod on the VPS and fill in. Never commit the real file.
APP_DOMAIN=hr.example.com
POSTGRES_USER=rfs
POSTGRES_PASSWORD=change-me-long-random
POSTGRES_DB=rfs_hcm
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Back this key up separately from the database: without it, bank details and CNICs cannot be decrypted.
FIELD_ENCRYPTION_KEY=
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30
